{
  "expo": {
    "name": "Loadsy",
    "slug": "loadsy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "loadsy",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.loadsy.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Loadsy reads the photos you select to identify furniture and estimate your moving volume. It never uploads photos you haven't selected.",
          "cameraPermission": "Loadsy uses your camera to photograph rooms so it can identify your furniture and estimate how much truck space your move needs. Photos are used only to build your inventory.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.loadsy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B7A62"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "server"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0354a3bd-76ac-4a62-8aee-bfb81004f9df"
      }
    },
    "owner": "jdsitton",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0354a3bd-76ac-4a62-8aee-bfb81004f9df"
    },
    "backgroundColor": "#FFFFFF"
  }
}
