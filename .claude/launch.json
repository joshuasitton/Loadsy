{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "loadsy-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "loadsy-demo",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "EXPO_PUBLIC_USE_MOCKS=true npx expo start --web --port 8082"
      ],
      "port": 8082
    }
  ]
}
