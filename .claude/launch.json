{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "loadsy-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "loadsy-demo",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "EXPO_PUBLIC_USE_MOCKS=true npx expo start --web --port 8082"
      ],
      "port": 8082
    },
    {
      "name": "loadsy-live",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "EXPO_PUBLIC_USE_MOCKS=false npx expo start --web --port 8083"
      ],
      "port": 8083
    },
    {
      "name": "loadsy-release",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx expo export -p web && npx expo serve --port 8084"
      ],
      "port": 8084
    },
    {
      "name": "loadsy-sim",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "EXPO_PUBLIC_DEMO_MODE=true EXPO_PUBLIC_USE_MOCKS=true npx expo start --ios --port 8086"
      ],
      "port": 8086
    },
    {
      "name": "loadsy-sim-release",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "EXPO_PUBLIC_DEMO_MODE=false EXPO_PUBLIC_USE_MOCKS=true npx expo start --port 8086"
      ],
      "port": 8086
    }
  ]
}
